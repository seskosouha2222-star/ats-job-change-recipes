    {
      "id": "66f9ddd5-584f-5614-a5d7-23f99301282d",
      "name": "Build account digest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        640
      ],
      "parameters": {
        "jsCode": "// One Slack message per run: new or reopened roles and the selected signals, grouped by account.\nconst cfg = $('Configuration').first().json;\nconst wanted = new Set(cfg.alertSignalTypes || []);\nconst accounts = new Map();\nconst entry = (r) => {\n  const key = r.companyName || r.companySlug || 'unknown';\n  if (!accounts.has(key)) accounts.set(key, { roles: [], signals: [] });\n  return accounts.get(key);\n};\nfor (const item of $input.all()) {\n  const r = item.json;\n  if (r.recordType === 'job' && (r.changeType === 'new' || r.changeType === 'reopened')) {\n    entry(r).roles.push(r.changeType === 'reopened' ? r.title + ' (reopened)' : r.title);\n  } else if (r.recordType === 'signal' && wanted.has(r.signalType) && (r.confidence ?? 0) >= cfg.minConfidence) {\n    entry(r).signals.push(r.statement);\n  }\n}\nif (accounts.size === 0) return [];\nconst out = ['*Hiring changes at your accounts*'];\nfor (const [name, a] of [...accounts.entries()].sort((x, y) => x[0].localeCompare(y[0]))) {\n  const parts = [];\n  if (a.roles.length) {\n    const shown = a.roles.slice(0, 5).join('; ');\n    parts.push(a.roles.length + ' new role' + (a.roles.length > 1 ? 's' : '') + ': ' + shown + (a.roles.length > 5 ? ' …' : ''));\n  }\n  for (const statement of a.signals) parts.push('Signal: ' + statement);\n  out.push('• *' + name + '*: ' + parts.join(' | '));\n}\nreturn [{ json: { text: out.join('\\n') } }];"
      }
    },
    {
