              "name": "maxTotalChargeUsd",
              "value": "1"
            },
            {
              "name": "clean",
              "value": "true"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ companies: $json.companies, monitorId: $json.monitorId, mode: 'changes', emitBaseline: false, emitSignals: true, emitCompanySummaries: true, includeClosed: true, includeDescription: false }) }}",
