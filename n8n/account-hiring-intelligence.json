      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        300
      ],
      "parameters": {
        "jsCode": "// Boards the Actor could not read in this run: nothing was written for them, and the next run retries.\nconst unread = $input.all().map(i => i.json).map(c => (c.companyName || c.companySlug) + ' (' + c.ats + ': ' + (c.errorCode || c.status) + ')');\nif (unread.length === 0) return [];\nreturn [{ json: { text: 'Job boards not read this run (retried next run): ' + unread.join(', ') } }];"
      }
    },
    {
      "id": "680edb63-c61b-5168-83d6-e9f486cfd4f2",
