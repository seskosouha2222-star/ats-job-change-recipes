{
  "name": "New roles at target companies to Slack (ATS Job Changes Feed)",
  "nodes": [
    {
      "id": "fb525746-620f-5f76-a977-8666f09c44bd",
      "name": "Setup",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -480,
        -120
      ],
      "parameters": {
        "content": "## New roles at your target companies \u2192 Slack\n1. **Run ATS Job Changes Feed**: create a Header Auth credential (`Authorization` = `Bearer <your Apify token>`), then edit `companies` (`greenhouse:<board>`, a Greenhouse/Lever/Ashby job-board URL, or a careers-page URL) and the optional `titleKeywords` / `locationKeywords`.\n2. **Post to Slack**: paste your Slack incoming-webhook URL.\n3. Activate. The first run is silent (`emitBaseline: false`); later runs return only roles that are new or reopened since the previous run.\n\nCost: pay per event on Apify, capped per run by `maxTotalChargeUsd`. Unchanged jobs are free.",
        "width": 440,
        "height": 360
      }
    },
    {
      "id": "869d49ac-98da-58fe-939b-045ee4eee20f",
      "name": "Every morning",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "triggerAtHour": 7
            }
          ]
        }
      }
    },
    {
      "id": "3a587945-4822-5cfb-8605-c561608bece3",
      "name": "Run ATS Job Changes Feed",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ],
      "notes": "Credential: Header Auth, name 'Authorization', value 'Bearer <your Apify API token>'. Keep monitorId unchanged between runs: it is the memory that makes each run return only changes. maxTotalChargeUsd caps what one run can cost.",
      "parameters": {
        "method": "POST",
        "url": "https://api.apify.com/v2/acts/agitools~ats-jobs-delta/run-sync-get-dataset-items",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "maxTotalChargeUsd",
              "value": "1"
            },
            {
              "name": "clean",
              "value": "true"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"companies\": [\n    \"greenhouse:stripe\",\n    \"https://jobs.lever.co/palantir\",\n    \"https://jobs.ashbyhq.com/openai\"\n  ],\n  \"monitorId\": \"n8n-slack-alerts\",\n  \"mode\": \"changes\",\n  \"emitBaseline\": false,\n  \"includeDescription\": false,\n  \"emitCompanySummaries\": false,\n  \"titleKeywords\": [\n    \"engineer\",\n    \"data\"\n  ]\n}",
        "options": {
          "timeout": 300000
        }
      }
    },
    {
      "id": "2ebf41bd-5af8-5dcb-b863-29fdc17bd08f",
      "name": "Jobs only",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "168238cc-c987-5235-b3c3-7d08193e6a3c",
              "leftValue": "={{ $json.recordType }}",
              "rightValue": "job",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "1dfd3aec-6f53-513d-acc3-bd3de4223d4b",
      "name": "New or reopened",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2,
      "position": [
        720,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "6a6dbd97-ba22-5e34-b0f4-cbcddf57780c",
              "leftValue": "={{ $json.changeType }}",
              "rightValue": "new",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "30daa7e5-981a-5ab9-92eb-05c65fc5132b",
              "leftValue": "={{ $json.changeType }}",
              "rightValue": "reopened",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "or"
        },
        "options": {}
      }
    },
    {
      "id": "bca93e42-aa4a-5330-b71c-819dc6015d45",
      "name": "Post to Slack",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        0
      ],
      "notes": "Replace the URL with your own Slack incoming-webhook URL.",
      "parameters": {
        "method": "POST",
        "url": "https://hooks.slack.com/services/REPLACE/WITH/YOUR_WEBHOOK",
        "sendBody": true,
        "specifyBody": "keypair",
        "bodyParameters": {
          "parameters": [
            {
              "name": "text",
              "value": "={{ $json.changeType === 'reopened' ? 'Reopened' : 'New' }} role at {{ $json.companyName || $json.companySlug }}: {{ $json.title }} ({{ ($json.locations || []).join(', ') }}) {{ $json.url }}"
            }
          ]
        },
        "options": {}
      }
    }
  ],
  "connections": {
    "Every morning": {
      "main": [
        [
          {
            "node": "Run ATS Job Changes Feed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run ATS Job Changes Feed": {
      "main": [
        [
          {
            "node": "Jobs only",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Jobs only": {
      "main": [
        [
          {
            "node": "New or reopened",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "New or reopened": {
      "main": [
        [
          {
            "node": "Post to Slack",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "meta": {
    "templateCredsSetupCompleted": false
  }
}
